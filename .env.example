# Copy to app/env/dev.json (or staging.json / prod.json) and run:
#   flutter run --dart-define-from-file=env/dev.json
# JSON form of the same keys:
#   {"FLAVOR":"dev","SUPABASE_URL":"http://127.0.0.1:54421","SUPABASE_ANON_KEY":"<publishable key from `supabase status`>"}
FLAVOR=dev
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=
